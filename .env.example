PORT=5000

# Lokalni MongoDB ili MongoDB Atlas, npr:
# mongodb+srv://KORISNIK:LOZINKA@klaster.xxxxx.mongodb.net/zavrzlama?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/zavrzlama

# Tajni ključ za potpisivanje JWT tokena (dugačak nasumičan tekst). Generisanje:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=promeni-me-u-dugacak-nasumican-tekst
