{
  "name": "zavrzlama-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Backend API for Zavrzlama daily games platform",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/scripts/seedWords.js",
    "check": "node --check src/app.js && node --check src/server.js && node --check src/config/db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1"
  }
}
